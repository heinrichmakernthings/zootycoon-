{
  "name": "cutise-zoo",
  "version": "0.1.0",
  "private": true,
  "description": "A little zoo. A lot of personality. A cosy isometric zoo tycoon for the browser.",
  "scripts": {
    "dev": "node tools/serve.js",
    "test": "node --test test/*.test.js",
    "format": "prettier --write \"js/**/*.js\" \"tools/**/*.js\" \"test/**/*.js\" \"!js/art.js\"",
    "zoo-art": "node tools/art.js"
  },
  "devDependencies": {
    "prettier": "3.3.3"
  },
  "engines": {
    "node": ">=20"
  }
}
