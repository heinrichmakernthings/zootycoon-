// Cloudflare Workers: serves Cutise Zoo as static files. Deploy with `npx wrangler deploy`, or connect the GitHub repo in the Cloudflare dashboard.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cutise-zoo",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "."
  }
}
